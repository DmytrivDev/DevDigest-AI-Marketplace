---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { t } from '../i18n/en';
---
<Base title={t.notFound.title} description={t.notFound.description} path="404.html" noindex>
  <div class="page-body" style="padding-top:48px;padding-bottom:48px">
    <div class="narrow-560 stack" style="gap:16px">
      <span class="mono muted" style="font-size:13px">404</span>
      <h1 class="h1">{t.notFound.title}</h1>
      <p class="muted" style="font-size:16px">{t.notFound.text}</p>
      <form role="search" action={url()} method="get" class="nf-form">
        <label for="nf-q" class="sr-only">{t.notFound.searchLabel}</label>
        <input id="nf-q" name="q" type="text" placeholder={t.notFound.placeholder} autocomplete="off" />
        <button type="submit" class="btn-primary" style="height:44px">{t.notFound.submit}</button>
      </form>
      <div class="link-row">
        <a href={url('guide/')}>{t.notFound.guide}</a>
        <a href={url()}>{t.notFound.back}</a>
      </div>
    </div>
  </div>
</Base>
