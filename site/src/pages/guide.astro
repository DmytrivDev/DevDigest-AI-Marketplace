---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Rich from '../components/Rich.astro';
import TypeBadge from '../components/TypeBadge.astro';
import { loadSiteData } from '../data/load';
import { addCommand, installCommand, marketplaceInfo, removeCommand, updateCommand } from '../lib/commands';
import { components, plugins, repoUrl } from '../lib/site';
import { url } from '../lib/url';
import type { ArtifactType } from '../lib/types';

const { catalog } = await loadSiteData();
const m = marketplaceInfo(catalog);
const gh = repoUrl(catalog);
const plugin = plugins(catalog)[0]?.name ?? '<plugin>';
const comps = components(catalog);
const skill = comps.find((a) => a.type === 'skill');
const command = comps.find((a) => a.type === 'command');
const exSkill = skill?.invoke ?? `/${plugin}:<skill>`;
const exCommand = command?.invoke ?? `/${plugin}:<command>`;

const toc: [string, string][] = [
  ['g-add', 'Add the marketplace'],
  ['g-install', 'Install a plugin'],
  ['g-invoke', 'Find and invoke'],
  ['g-types', 'Artifact types'],
  ['g-update', 'Update and remove'],
  ['g-problems', 'Common problems'],
  ['g-authors', 'For authors'],
];
const types: [ArtifactType, string, string][] = [
  ['plugin', 'A versioned bundle of the artifacts below.', `Install it: \`${installCommand(plugin, m)}\``],
  ['skill', 'Instructions and files Claude loads for a specific task.', `Invoke by name, \`${exSkill}\`, or let Claude pick it from its description.`],
  ['agent', 'A subagent with its own prompt and tools.', 'Claude delegates matching tasks. You can also ask for it by name.'],
  ['command', 'A slash command, optionally with arguments.', `Type it: \`${exCommand}\``],
  ['hook', 'A script that runs on a Claude Code event.', 'Runs automatically once the plugin is installed.'],
  ['mcp', 'A server that gives Claude extra tools and data.', 'Starts with the plugin. Set the env vars it needs, if the plugin page lists any.'],
];
const problems: [string, string, string][] = [
  ['“Marketplace not found”', 'A typo in the repository path, or no access to it.', `Check the path \`${m.repo}\` and that you can open it on GitHub.`],
  [`\`${exSkill}\` isn't recognized`, "The plugin isn't installed, or the session started before the install.", 'Install the plugin, then restart Claude Code.'],
  ['An MCP server fails to start', 'An environment variable it needs isn\'t set.', 'Set the variables listed on the plugin page before starting Claude Code.'],
  ['A command is blocked', 'A hook from an installed plugin matched its rule.', 'Read the message the hook prints, fix the cause and run the command again.'],
];
---
<Base title="Guide" description="How to add this marketplace to Claude Code, install plugins and use what's inside." nav="guide" path="guide/">
  <div class="page-body" style="gap:0">
    <div class="guide-grid">
      <nav aria-label="On this page" class="guide-toc" data-toc>
        <span class="muted" style="font-size:13px;font-weight:600">On this page</span>
        <ol>
          {toc.map(([id, label], i) => <li><a href={`#${id}`} aria-current={i === 0 ? 'location' : undefined}>{label}</a></li>)}
        </ol>
      </nav>
      <article class="guide">
        <header class="stack" style="gap:8px">
          <h1 class="h1">Guide</h1>
          <p class="muted" style="font-size:16px">How to add this marketplace to Claude Code, install plugins and use what's inside.</p>
        </header>

        <section id="g-add" aria-labelledby="g-add-h">
          <h2 id="g-add-h">Add the marketplace</h2>
          <p>Run this once in Claude Code. It registers the repository as a marketplace named <code class="ic">{m.name}</code>.</p>
          <CopyCommand cmd={addCommand(m)} />
        </section>

        <section id="g-install" aria-labelledby="g-install-h">
          <h2 id="g-install-h">Install a plugin</h2>
          <p>Install by plugin name and marketplace. Everything inside the plugin is installed together: skills, agents, commands, hooks and the MCP server.</p>
          <CopyCommand cmd={installCommand(plugin, m)} />
          <p class="muted">If the new commands don't show up, restart Claude Code.</p>
        </section>

        <section id="g-invoke" aria-labelledby="g-invoke-h">
          <h2 id="g-invoke-h">Find and invoke</h2>
          <p>Search the <a href={url()}>catalog</a> in plain words, then copy the command from the card. Skills and commands are invoked by name:</p>
          <CopyCommand cmd={exSkill} />
          <p>Agents, hooks and MCP servers have no command of their own. Claude delegates to agents when a task matches, hooks run on their event, and MCP servers start with the plugin.</p>
        </section>

        <section id="g-types" aria-labelledby="g-types-h">
          <h2 id="g-types-h">Artifact types</h2>
          <div class="box gtable" role="table" aria-label="Artifact types">
            <div class="gtable__row gtable__head gtable__row--types" role="row"><span role="columnheader">Type</span><span role="columnheader">What it is</span><span role="columnheader">How you use it</span></div>
            {types.map(([ty, what, how]) => (
              <div class="gtable__row gtable__row--types" role="row">
                <span role="cell"><TypeBadge type={ty} /></span>
                <span role="cell">{what}</span>
                <span role="cell" style="overflow-wrap:anywhere"><Rich text={how} /></span>
              </div>
            ))}
          </div>
        </section>

        <section id="g-update" aria-labelledby="g-update-h">
          <h2 id="g-update-h">Update and remove</h2>
          <p>Pull the latest versions of every plugin in the marketplace:</p>
          <CopyCommand cmd={updateCommand(m)} />
          <p>Remove a plugin:</p>
          <CopyCommand cmd={removeCommand(plugin, m)} />
          <p class="muted">See <a href={url('whats-new/')}>What's new</a> for what changed in each release.</p>
        </section>

        <section id="g-problems" aria-labelledby="g-problems-h">
          <h2 id="g-problems-h">Common problems</h2>
          <div class="box gtable" role="table" aria-label="Common problems">
            <div class="gtable__row gtable__head gtable__row--probs" role="row"><span role="columnheader">Problem</span><span role="columnheader">Cause</span><span role="columnheader">Fix</span></div>
            {problems.map(([p, c, f]) => (
              <div class="gtable__row gtable__row--probs" role="row">
                <span role="cell" style="font-weight:600;overflow-wrap:anywhere"><Rich text={p} /></span>
                <span role="cell" class="muted" style="overflow-wrap:anywhere"><Rich text={c} /></span>
                <span role="cell" style="overflow-wrap:anywhere"><Rich text={f} /></span>
              </div>
            ))}
          </div>
        </section>

        <section id="g-authors" aria-labelledby="g-authors-h">
          <h2 id="g-authors-h">For authors</h2>
          <p>Plugins live in the <code class="ic">plugins/</code> folder of the repository and are listed in <code class="ic">.claude-plugin/marketplace.json</code>. Open a pull request with your plugin. Validation runs on every build and its result appears as a badge on the plugin page.</p>
          <a href={gh} target="_blank" rel="noopener">Open the repository →</a>
        </section>
      </article>
    </div>
  </div>
</Base>
