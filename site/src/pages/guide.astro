---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Rich from '../components/Rich.astro';
import TypeBadge from '../components/TypeBadge.astro';
import { loadSiteData } from '../data/load';
import { addCommand, disableCommand, installCommand, marketplaceInfo, pluginUpdateCommand, removeCommand, updateCommand } from '../lib/commands';
import { components, plugins, repoUrl } from '../lib/site';
import { url } from '../lib/url';
import { t } from '../i18n/en';
import type { ArtifactType } from '../lib/types';

const { catalog } = await loadSiteData();
const m = marketplaceInfo(catalog);
const gh = repoUrl(catalog);
const plugin = plugins(catalog)[0]?.name ?? t.home.pluginPlaceholder;
const comps = components(catalog);
const skill = comps.find((a) => a.type === 'skill');
const command = comps.find((a) => a.type === 'command');
const exSkill = skill?.invoke ?? t.guide.exampleSkill(plugin);
const exCommand = command?.invoke ?? t.guide.exampleCommand(plugin);

const g = t.guide;
const toc: [string, string][] = [
  ['g-add', g.toc.add],
  ['g-install', g.toc.install],
  ['g-invoke', g.toc.invoke],
  ['g-types', g.toc.types],
  ['g-update', g.toc.update],
  ['g-problems', g.toc.problems],
  ['g-authors', g.toc.authors],
];
// The argument of each "how you use it" text: the install command, or the example invoke command.
const howArg: Record<ArtifactType, string> = {
  plugin: installCommand(plugin, m),
  skill: exSkill,
  agent: '',
  command: exCommand,
  hook: '',
  mcp: '',
};
const types: [ArtifactType, string, string][] = (['plugin', 'skill', 'agent', 'command', 'hook', 'mcp'] as const).map(
  (ty) => [ty, g.typesTable.what[ty], g.typesTable.how[ty](howArg[ty])],
);
const pr = g.problems;
const problems: [string, string, string][] = [
  [pr.notFound.problem, pr.notFound.cause, pr.notFound.fix(m.repo)],
  [pr.notRecognized.problem(exSkill), pr.notRecognized.cause, pr.notRecognized.fix],
  [pr.mcpFails.problem, pr.mcpFails.cause, pr.mcpFails.fix],
  [pr.blocked.problem, pr.blocked.cause, pr.blocked.fix],
];
---
<Base title={g.title} description={g.description} nav="guide" path="guide/">
  <div class="page-body" style="gap:0">
    <div class="guide-grid">
      <nav aria-label={g.onThisPage} class="guide-toc" data-toc>
        <span class="muted" style="font-size:13px;font-weight:600">{g.onThisPage}</span>
        <ol>
          {toc.map(([id, label], i) => <li><a href={`#${id}`} aria-current={i === 0 ? 'location' : undefined}>{label}</a></li>)}
        </ol>
      </nav>
      <article class="guide">
        <header class="stack" style="gap:8px">
          <h1 class="h1">{g.title}</h1>
          <p class="muted" style="font-size:16px">{g.description}</p>
        </header>

        <section id="g-add" aria-labelledby="g-add-h">
          <h2 id="g-add-h">{g.toc.add}</h2>
          <p><Rich text={g.add.text(m.name)} /></p>
          <CopyCommand cmd={addCommand(m)} />
        </section>

        <section id="g-install" aria-labelledby="g-install-h">
          <h2 id="g-install-h">{g.toc.install}</h2>
          <p>{g.install.text}</p>
          <CopyCommand cmd={installCommand(plugin, m)} />
          <p class="muted">{g.install.restart}</p>
        </section>

        <section id="g-invoke" aria-labelledby="g-invoke-h">
          <h2 id="g-invoke-h">{g.toc.invoke}</h2>
          <p>{g.invoke.before}<a href={url()}>{g.invoke.catalog}</a>{g.invoke.after}</p>
          <CopyCommand cmd={exSkill} />
          <p>{g.invoke.agents}</p>
        </section>

        <section id="g-types" aria-labelledby="g-types-h">
          <h2 id="g-types-h">{g.toc.types}</h2>
          <div class="box gtable" role="table" aria-label={g.typesTable.aria}>
            <div class="gtable__row gtable__head gtable__row--types" role="row"><span role="columnheader">{g.typesTable.colType}</span><span role="columnheader">{g.typesTable.colWhat}</span><span role="columnheader">{g.typesTable.colHow}</span></div>
            {types.map(([ty, what, how]) => (
              <div class="gtable__row gtable__row--types" role="row">
                <span role="cell"><TypeBadge type={ty} /></span>
                <span role="cell">{what}</span>
                <span role="cell" style="overflow-wrap:anywhere"><Rich text={how} /></span>
              </div>
            ))}
          </div>
        </section>

        <section id="g-update" aria-labelledby="g-update-h">
          <h2 id="g-update-h">{g.toc.update}</h2>
          <p><Rich text={g.update.refresh} /></p>
          <CopyCommand cmd={updateCommand(m)} />
          <p><Rich text={g.update.upgrade} /></p>
          <CopyCommand cmd={pluginUpdateCommand(plugin, m)} />
          <p><Rich text={g.update.autoUpdate} /></p>
          <p><Rich text={g.update.disable} /></p>
          <CopyCommand cmd={disableCommand(plugin)} />
          <p><Rich text={g.update.remove} /></p>
          <CopyCommand cmd={removeCommand(plugin, m)} />
          <p class="muted">{g.update.seeBefore}<a href={url('whats-new/')}>{g.update.whatsNew}</a>{g.update.seeAfter}</p>
        </section>

        <section id="g-problems" aria-labelledby="g-problems-h">
          <h2 id="g-problems-h">{g.toc.problems}</h2>
          <div class="box gtable" role="table" aria-label={g.problems.aria}>
            <div class="gtable__row gtable__head gtable__row--probs" role="row"><span role="columnheader">{g.problems.colProblem}</span><span role="columnheader">{g.problems.colCause}</span><span role="columnheader">{g.problems.colFix}</span></div>
            {problems.map(([p, c, f]) => (
              <div class="gtable__row gtable__row--probs" role="row">
                <span role="cell" style="font-weight:600;overflow-wrap:anywhere"><Rich text={p} /></span>
                <span role="cell" class="muted" style="overflow-wrap:anywhere"><Rich text={c} /></span>
                <span role="cell" style="overflow-wrap:anywhere"><Rich text={f} /></span>
              </div>
            ))}
          </div>
        </section>

        <section id="g-authors" aria-labelledby="g-authors-h">
          <h2 id="g-authors-h">{g.toc.authors}</h2>
          <p><Rich text={g.authors.text} /></p>
          <a href={gh} target="_blank" rel="noopener">{g.authors.link}</a>
        </section>
      </article>
    </div>
  </div>
</Base>
