---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CopyCommand from '../../../components/CopyCommand.astro';
import SecurityPanel from '../../../components/SecurityPanel.astro';
import TypeBadge from '../../../components/TypeBadge.astro';
import ValidationBadge from '../../../components/ValidationBadge.astro';
import { loadSiteData } from '../../../data/load';
import { renderMarkdown } from '../../../data/markdown';
import { addCommand, installCommand, marketplaceInfo } from '../../../lib/commands';
import { formatDate } from '../../../lib/format';
import { TYPE_PLURAL } from '../../../lib/icons';
import { artifactHref, pluginHref, repoUrl, releaseSummary, splitMessage } from '../../../lib/site';
import { TYPE_ORDER } from '../../../lib/types';
import { url } from '../../../lib/url';
import { stripCode } from '../../../lib/richtext';
import { t } from '../../../i18n/en';

export async function getStaticPaths() {
  const { catalog } = await loadSiteData();
  return catalog.artifacts.filter((a) => a.type === 'plugin').map((a) => ({ params: { plugin: a.plugin } }));
}

const { plugin: name } = Astro.params;
const { catalog, changelog, readmes, compatDocs } = await loadSiteData();
const m = marketplaceInfo(catalog);
const p = catalog.artifacts.find((a) => a.type === 'plugin' && a.plugin === name)!;
const comps = catalog.artifacts.filter((a) => a.plugin === name && a.type !== 'plugin');
const external = !!p.external;
const val = p.validation ?? { status: 'unknown' as const, messages: [] };
const groups = TYPE_ORDER.map((ty) => ({ type: ty, items: comps.filter((a) => a.type === ty) })).filter((g) => g.items.length);
const readmeHtml = readmes[name!]
  ? await renderMarkdown(readmes[name!], { headingOffset: 1, dropFirstH1: true, linkBase: `${repoUrl(catalog)}/blob/${catalog.commit}/${p.sourcePath}/` })
  : '';
const compatHtml = !external && compatDocs[name!]
  ? await renderMarkdown(compatDocs[name!], { headingOffset: 1, dropFirstH1: true, idPrefix: 'compat-', linkBase: `${repoUrl(catalog)}/blob/${catalog.commit}/${p.sourcePath}/` })
  : '';
const pluginsByName = new Map(catalog.artifacts.filter((a) => a.type === 'plugin').map((a) => [a.name, a]));
// Dependencies (plugin.json): internal ones link to their plugin page when it exists.
const deps = (p.dependencies ?? []).map((d) => {
  const target = d.internal ? pluginsByName.get(d.name) : undefined;
  return {
    name: d.name,
    version: d.version,
    href: target ? pluginHref(target.plugin) : null,
    note: !d.internal && d.marketplace ? t.plugin.depFromMarketplace(d.marketplace) : target ? stripCode(target.description) : t.plugin.depNotListed,
  };
});
const usedBy = (p.usedBy ?? []).map((u) => ({ name: u, href: pluginHref(u), description: stripCode(pluginsByName.get(u)?.description ?? '') }));
const claudeCode = p.compatibility?.claudeCode ?? null;
const versions = changelog.releases.filter((r) => r.plugin === name).slice(0, 5);
const lastRelease = versions[0]?.date;
const tip = external ? t.plugin.tipExternal : t.plugin.tipNoValidator;
const meta: [string, string, boolean][] = [
  [t.plugin.metaVersion, p.version ?? '—', true],
  ...(claudeCode ? ([[t.plugin.metaCompatibility, t.plugin.claudeCodeRange(claudeCode), false]] as [string, string, boolean][]) : []),
  [t.plugin.metaCategory, p.category ?? '—', true],
  [t.plugin.metaAuthor, p.details.author ?? '—', false],
  [t.plugin.metaArtifacts, external ? t.plugin.unavailable : String(comps.length), false],
  [t.plugin.metaLastRelease, lastRelease ? formatDate(lastRelease) : '—', false],
  [t.plugin.metaSource, p.sourcePath, true],
];
const sourceUrl = external ? `https://${p.sourcePath}` : `${repoUrl(catalog)}/tree/${catalog.commit}/${p.sourcePath}`;
---
<Base title={t.plugin.pageTitle(p.name)} description={p.description} nav="catalog" path={`plugins/${p.plugin}/`} feed={external ? undefined : { href: url(`plugins/${p.plugin}/feed.xml`), title: t.feed.pluginTitle(p.plugin, t.site.name) }}>
  <div class="page-body">
    <Breadcrumb items={[{ label: t.nav.catalog, href: url() }, { label: p.name, mono: true }]} />
    <header class="stack" style="gap:12px">
      <div class="badge-row">
        <TypeBadge type="plugin" />
        {p.version && <span class="ver-badge">{t.plugin.versionBadge(p.version)}</span>}
        <ValidationBadge status={external ? 'unknown' : val.status} tip={tip} />
        {external && <span class="ext-badge">{t.plugin.external}</span>}
      </div>
      <h1 class="h1 mono">{p.name}</h1>
      {p.description && <p class="lead">{p.description}</p>}
    </header>

    {val.status === 'fail' && !external && (
      <section class="fail-box" role="alert" aria-labelledby="p-fail">
        <h2 id="p-fail" class="h2 h2--sm" style="color:var(--danger)">{t.plugin.failedHeading(val.messages.length)}</h2>
        <ul>
          {val.messages.map((msg) => {
            const x = splitMessage(msg);
            return <li>{x.file && <code class="mono strong">{x.file}</code>} {x.msg}</li>;
          })}
        </ul>
        <p class="muted" style="font-size:13px">{t.plugin.checked(formatDate(catalog.generatedAt), catalog.commit.slice(0, 7))}</p>
      </section>
    )}

    <div class="two-col">
      <div class="col-main">
        <section class="stack gap12" aria-labelledby="p-install">
          <h2 id="p-install" class="h2">{t.plugin.install}</h2>
          <ol class="install-steps">
            <li><span class="muted small">{t.plugin.installStep1}</span><CopyCommand cmd={addCommand(m)} /></li>
            <li><span class="muted small">{t.plugin.installStep2}</span><CopyCommand cmd={installCommand(p.plugin, m)} /></li>
          </ol>
          {deps.length > 0 && <p class="muted small">{t.plugin.depsAutoInstall(deps.length)}</p>}
          <a class="small" href={url(`settings-builder/?plugin=${encodeURIComponent(p.plugin)}`)}>{t.plugin.addToSettings}</a>
        </section>

        {(!external || usedBy.length > 0) && (
          <section class="stack gap12" aria-labelledby="p-deps">
            <h2 id="p-deps" class="h2">{t.plugin.dependencies}</h2>
            {!external && (deps.length ? (
              <ul class="art-list">
                {deps.map((d) => (
                  <li>
                    {d.href ? <a class="mono strong" href={d.href}>{d.name}</a> : <span class="mono strong">{d.name}</span>}
                    <span class="muted">{d.version ? <span class="mono">{d.version}</span> : t.plugin.depAnyVersion}{d.note && ` · ${d.note}`}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">{t.plugin.noDependencies}</p>
            ))}
            <div class="stack">
              <h3 class="group-h">{t.plugin.usedBy}</h3>
              {usedBy.length ? (
                <ul class="art-list">
                  {usedBy.map((u) => (
                    <li><a class="mono strong" href={u.href}>{u.name}</a><span class="muted">{u.description}</span></li>
                  ))}
                </ul>
              ) : (
                <p class="muted">{t.plugin.notUsedBy}</p>
              )}
            </div>
          </section>
        )}

        {external ? (
          <section class="box box--surface pad16 stack gap8">
            <p><strong>{t.plugin.unavailableLead}</strong>{t.plugin.unavailableText}</p>
            <a href={sourceUrl} target="_blank" rel="noopener">{t.plugin.viewSource}</a>
          </section>
        ) : (
          <>
            <section class="stack gap12" aria-labelledby="p-contents">
              <h2 id="p-contents" class="h2">{t.plugin.contents}</h2>
              {groups.length ? (
                <ul class="contents">
                  {groups.map((g) => (
                    <li><TypeBadge type={g.type} label={TYPE_PLURAL[g.type]} /><span class="num">{g.items.length}</span></li>
                  ))}
                </ul>
              ) : (
                <p class="muted">{t.states.noComponents}</p>
              )}
            </section>
            {groups.length > 0 && (
              <section class="stack" style="gap:20px" aria-labelledby="p-arts">
                <h2 id="p-arts" class="h2">{t.plugin.artifacts}</h2>
                {groups.map((g) => (
                  <div class="stack">
                    <h3 class="group-h"><TypeBadge type={g.type} label={TYPE_PLURAL[g.type]} /><span class="muted" style="font-weight:400">{g.items.length}</span></h3>
                    <ul class="art-list">
                      {g.items.map((a) => (
                        <li><a class="mono strong" href={artifactHref(a)}>{a.name}</a><span class="muted">{stripCode(a.description)}</span></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </section>
            )}
            {p.details.security && <SecurityPanel plugin={p.plugin} security={p.details.security} />}
            {readmeHtml && (
              <section class="stack gap12" aria-labelledby="p-readme">
                <h2 id="p-readme" class="h2">{t.plugin.readme}</h2>
                <div class="box readme"><div class="md" set:html={readmeHtml} /></div>
              </section>
            )}
            {compatHtml && (
              <section class="stack gap12" aria-labelledby="p-compat">
                <h2 id="p-compat" class="h2">{t.plugin.compatibility}</h2>
                <details class="notes">
                  <summary>{t.plugin.compatibilityShow}</summary>
                  <div class="box readme" style="margin-top:8px"><div class="md" set:html={compatHtml} /></div>
                </details>
              </section>
            )}
          </>
        )}

        <section class="stack gap12" aria-labelledby="p-versions">
          <div class="row-head">
            <h2 id="p-versions" class="h2">{t.plugin.versionHistory}</h2>
            <a class="more" href={url('whats-new/')}>{t.plugin.allReleases}</a>
            {!external && <a class="more" href={url(`plugins/${p.plugin}/feed.xml`)}>{t.plugin.rssForPlugin}</a>}
          </div>
          {versions.length ? (
            <ul class="versions">
              {versions.map((v) => (
                <li>
                  <span class="mono strong">{v.version ?? '—'}</span>
                  <span>{releaseSummary(v)}</span>
                  <span class="muted small">{formatDate(v.date)} · <span class="mono">{v.commit.slice(0, 7)}</span></span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">{t.plugin.noReleases}</p>
          )}
        </section>
      </div>

      <aside class="box side-meta" aria-label={t.plugin.detailsAria}>
        <dl>
          {meta.map(([k, v, mono]) => (
            <>
              <dt>{k}</dt>
              <dd class={mono ? 'mono' : undefined}>{v}</dd>
            </>
          ))}
        </dl>
        {p.tags.length > 0 && (
          <div class="stack gap6">
            <span class="muted small">{t.plugin.tags}</span>
            <div class="tag-row">{p.tags.map((tg) => <span class="tag">{tg}</span>)}</div>
          </div>
        )}
        <a href={sourceUrl} target="_blank" rel="noopener">{t.plugin.sourceOnGithub}</a>
      </aside>
    </div>
  </div>
</Base>
